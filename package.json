{
  "name": "woolworths-mcp-server",
  "version": "1.2.0",
  "description": "MCP server for Woolworths Australia: product search, prices, specials and additive risk",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "build:additives": "node scripts/build-additives.mjs",
    "test": "npm run build && node --test 'test/*.test.mjs'",
    "start:http": "MCP_TRANSPORT=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "woolworths",
    "grocery",
    "shopping"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amasolov/woolworths-mcp.git"
  },
  "engines": {
    "node": ">=20"
  }
}
